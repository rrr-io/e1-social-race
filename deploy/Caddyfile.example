# Proposed hostname: change it and PUBLIC_ORIGIN together if needed.
# Append this block to /srv/caddy/Caddyfile; preserve all existing sites.
# The existing caddy container must be attached to the external web network.
social-pulse.rrriooo.com {
    encode zstd gzip
    reverse_proxy e1-social-pulse:8000
}

# EMGP26 certificates on their own subdomain (same container, no extra deploy).
# Point the subdomain's DNS (A/AAAA) to the server, change the hostname, reload Caddy.
emgp26-certificates.enhypenvoting.com {
    encode zstd gzip
    @root path /
    rewrite @root /crew-license
    reverse_proxy e1-social-pulse:8000
}
