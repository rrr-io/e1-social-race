ADMIN_USER=admin
# Replace with a unique password of at least 12 characters before startup.
ADMIN_PASSWORD=
PUBLIC_ORIGIN=http://localhost:8000
POLL_INTERVAL_MINUTES=60
MAX_POSTS=100
# Optional: enable YouTube Data API v3 in Google Cloud and use a restricted API key.
YOUTUBE_API_KEY=
# Optional: absolute path outside the repository, used by compose.cookies.yaml.
# TIKTOK_COOKIES_HOST_PATH=/srv/e1-pulse-secrets/tiktok.cookies.txt
# Direct Python execution: local Netscape cookie file.
# Production: use /run/pulse-secrets/tiktok.cookies.txt; see deploy/README.md.
# TIKTOK_COOKIES_FILE=/absolute/private/path/tiktok.cookies.txt
